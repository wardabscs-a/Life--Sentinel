# ============================================
# Life Sentinel Backend — Environment Variables
# ============================================
# Copy to .env and fill in real values. NEVER commit .env.

# --- Server ---
PORT=4000
# Comma-separated origins allowed for CORS
CORS_ORIGINS=http://localhost:5173

# --- Firebase Admin SDK ---
# Path to your Firebase service account JSON key file (server-side only)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Your Firebase project ID
FIREBASE_PROJECT_ID=life-sentinel

# --- Admin / Dispatch ---
# Comma-separated emails allowed to access the dispatch dashboard
ADMIN_EMAILS=admin@lifesentinel.com

# --- Notification Providers ---
# Twilio (SMS) — leave blank to use "not_configured" status
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Business API — leave blank to use "not_configured" status
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Encryption ---
# Used to sign dispatch admin session tokens
SESSION_SECRET=change-this-to-a-random-string

# --- AI Provider (server-side only — never put in VITE_* variables) ---
# OpenAI or any compatible chat-completions endpoint
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo
