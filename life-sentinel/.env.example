# ============================================
# Life Sentinel — Frontend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real keys to version control.
#
# Backend secrets (Twilio, WhatsApp, Firebase Admin) are configured
# in server/.env — NOT here. Never put them in VITE_ variables.

# --- Backend Server ---
# URL of the Life Sentinel backend API server
# For local development: http://localhost:4000
# For production: https://your-api.example.com
# Leave as placeholder to run in demo/offline mode
VITE_BACKEND_URL=https://your-backend-api.com

# --- AI Service ---
# OpenAI / compatible API for emergency classification and guidance
VITE_AI_API_KEY=your_ai_api_key
VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
VITE_AI_MODEL=gpt-3.5-turbo

# --- Weather (Premium) ---
# Open-Meteo is used by default (free, no key needed).
# Set this to use OpenWeatherMap instead for higher accuracy.
VITE_OPENWEATHER_API_KEY=your_api_key
VITE_OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5

# --- Maps ---
# Google Maps API key (optional — OpenStreetMap/Leaflet used by default)
VITE_GOOGLE_MAPS_API_KEY=

# --- Firebase (client SDK) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

